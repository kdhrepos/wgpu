package switching

import (
	"fmt"
	"os"

	"gitlab.com/akita/akita"
	"gitlab.com/akita/noc"
	"gitlab.com/akita/protocol"
)

// deadlockWatchdogThreshold: cycles of stalled drain on a single end before
// the connection declares a deadlock. 100k cycles ≈ 100µs at 1GHz — orders
// of magnitude above any reasonable transient stall (full DRAM queue, cache
// miss train, etc.). Anything past this is a structural cyclic dependency.
const deadlockWatchdogThreshold = uint64(100000)

// pendingFlit carries a payload through the wire. arrivalCycle is the
// absolute cycle at which the flit becomes deliverable to dst; until
// then drainEnd treats it as still in transit and skips it.
type pendingFlit struct {
	msg          akita.Msg
	arrivalCycle uint64
}

type MultiFlitSwitchConnectionEnd struct {
	port akita.Port
	buf  []pendingFlit
	busy bool

	admittedCycle uint64
	admittedCount int

	// drainCycle/drainCount: per-cycle drain counter shared across all
	// drainEnd calls in the same VTime, so a flurry of triggers (Tick
	// plus dst.NotifyAvailable, etc.) cannot push the link past W
	// flits/cycle.
	drainCycle uint64
	drainCount int

	admittedTotal uint64

	// lastProgressCycle is the most recent cycle in which the watchdog
	// considers this end to have made progress: a successful drain to
	// dst, or a fresh admit that grew the in-flight set. When buf has
	// flits but this counter falls too far behind the current cycle,
	// the connection declares a deadlock.
	lastProgressCycle uint64
}

func newMultiFlitSwitchConnectionEnd(
	port akita.Port,
) *MultiFlitSwitchConnectionEnd {
	return &MultiFlitSwitchConnectionEnd{port: port}
}

type MultiFlitSwitchConnection struct {
	*akita.TickingComponent

	leftPort  akita.Port
	leftEnd   *MultiFlitSwitchConnectionEnd
	rightPort akita.Port
	rightEnd  *MultiFlitSwitchConnectionEnd

	row int
	col int

	pipelineWidth  int
	pipelineStages int
}

func (c *MultiFlitSwitchConnection) PlugIn(
	port akita.Port,
	sourceSideBufSize int,
) {
	c.Lock()
	defer c.Unlock()
	_ = sourceSideBufSize
	switch {
	case c.leftPort == nil:
		c.leftPort = port
		c.leftEnd = newMultiFlitSwitchConnectionEnd(port)
	case c.rightPort == nil:
		c.rightPort = port
		c.rightEnd = newMultiFlitSwitchConnectionEnd(port)
	default:
		panic("multiflit switch connection already has two ports")
	}
	port.SetConnection(c)
}

func (c *MultiFlitSwitchConnection) Unplug(port akita.Port) {
	panic("not implemented")
}

func (c *MultiFlitSwitchConnection) NotifyAvailable(
	now akita.VTimeInSec, port akita.Port,
) {
	c.TickNow(now)
}

func (c *MultiFlitSwitchConnection) Send(
	msg akita.Msg,
) *akita.SendError {
	c.Lock()
	defer c.Unlock()
	c.msgMustBeValid(msg)

	srcPort, payload := c.unwrapSendArgs(msg)
	srcEnd := c.endByPort(srcPort)
	if !c.tryAdmit(srcEnd, msg.Meta().SendTime) {
		srcEnd.busy = true
		return akita.NewSendError()
	}
	sendCycle := c.Freq.Cycle(msg.Meta().SendTime)
	arrivalTime := c.Freq.NCyclesLater(
		c.pipelineStages, msg.Meta().SendTime)
	srcEnd.buf = append(srcEnd.buf, pendingFlit{
		msg:          payload,
		arrivalCycle: sendCycle + uint64(c.pipelineStages),
	})

	c.TickNow(arrivalTime)
	return nil
}

func (c *MultiFlitSwitchConnection) unwrapSendArgs(
	msg akita.Msg,
) (akita.Port, akita.Msg) {
	if flit, ok := msg.(*noc.Flit); ok {
		return flit.Src, flit
	}
	if nm, ok := msg.(*protocol.NetworkMsg); ok {
		return nm.SrcPort, nm.Msg
	}
	panic("expected *noc.Flit or *protocol.NetworkMsg")
}

func (c *MultiFlitSwitchConnection) endByPort(
	p akita.Port,
) *MultiFlitSwitchConnectionEnd {
	switch p {
	case c.leftPort:
		return c.leftEnd
	case c.rightPort:
		return c.rightEnd
	}
	panic("source port unknown")
}

func (c *MultiFlitSwitchConnection) dstPortFor(
	end *MultiFlitSwitchConnectionEnd,
) akita.Port {
	if end == c.leftEnd {
		return c.rightPort
	}
	return c.leftPort
}

func (c *MultiFlitSwitchConnection) tryAdmit(
	end *MultiFlitSwitchConnectionEnd,
	now akita.VTimeInSec,
) bool {
	cycle := c.Freq.Cycle(now)
	if cycle != end.admittedCycle {
		end.admittedCycle = cycle
		end.admittedCount = 0
	}
	if end.admittedCount >= c.pipelineWidth {
		return false
	}
	if len(end.buf) >= c.bufferCapacity() {
		return false
	}
	end.admittedCount++
	end.admittedTotal++
	end.lastProgressCycle = cycle
	return true
}

func (c *MultiFlitSwitchConnection) LeftPortName() string {
	return c.leftPort.Name()
}

func (c *MultiFlitSwitchConnection) RightPortName() string {
	return c.rightPort.Name()
}

func (c *MultiFlitSwitchConnection) PipelineWidth() int {
	return c.pipelineWidth
}

func (c *MultiFlitSwitchConnection) AdmittedLeftToRight() uint64 {
	return c.leftEnd.admittedTotal
}

func (c *MultiFlitSwitchConnection) AdmittedRightToLeft() uint64 {
	return c.rightEnd.admittedTotal
}

func (c *MultiFlitSwitchConnection) Cycles(now akita.VTimeInSec) uint64 {
	return c.Freq.Cycle(now)
}

// bufferCapacity is the total in-flight cap per direction. For D≥1 it
// is W×D (the BDP). For D=0 the product collapses to 0, which would
// reject every admit, so fall back to one cycle's worth (W).
func (c *MultiFlitSwitchConnection) bufferCapacity() int {
	cap := c.pipelineWidth * c.pipelineStages
	if cap < 1 {
		cap = c.pipelineWidth
	}
	return cap
}

func (c *MultiFlitSwitchConnection) Tick(
	now akita.VTimeInSec,
) bool {
	madeProgress := false
	c.Lock()
	defer c.Unlock()
	madeProgress = c.drainEnd(c.leftEnd, now) || madeProgress
	madeProgress = c.drainEnd(c.rightEnd, now) || madeProgress
	madeProgress = c.notifyIfBusyReady(c.leftEnd, now) ||
		madeProgress
	madeProgress = c.notifyIfBusyReady(c.rightEnd, now) ||
		madeProgress
	// c.checkDeadlock(c.leftEnd, now)
	// c.checkDeadlock(c.rightEnd, now)
	return madeProgress
}

// drainEnd delivers up to pipelineWidth flits from buf to dst this
// cycle. It skips items whose arrivalCycle is still in the future
// (they are "on the wire") and stops on the first dst.Recv failure
// (HOL backpressure from dst).
func (c *MultiFlitSwitchConnection) drainEnd(
	end *MultiFlitSwitchConnectionEnd,
	now akita.VTimeInSec,
) bool {
	cycle := c.Freq.Cycle(now)
	if cycle != end.drainCycle {
		end.drainCycle = cycle
		end.drainCount = 0
	}

	madeProgress := false
	dst := c.dstPortFor(end)
	for end.drainCount < c.pipelineWidth && len(end.buf) > 0 {
		head := end.buf[0]
		if head.arrivalCycle > cycle {
			break // still on the wire
		}
		head.msg.Meta().RecvTime = now
		if err := dst.Recv(head.msg); err != nil {
			break
		}
		end.buf = end.buf[1:]
		end.drainCount++
		end.lastProgressCycle = cycle
		if end.busy {
			end.port.NotifyAvailable(now)
			end.busy = false
		}
		madeProgress = true
	}
	return madeProgress
}

func (c *MultiFlitSwitchConnection) notifyIfBusyReady(
	end *MultiFlitSwitchConnectionEnd,
	now akita.VTimeInSec,
) bool {
	if !end.busy {
		return false
	}
	cycle := c.Freq.Cycle(now)
	cycleSaturated := cycle == end.admittedCycle &&
		end.admittedCount >= c.pipelineWidth
	bufFull := len(end.buf) >= c.bufferCapacity()
	if cycleSaturated || bufFull {
		return false
	}
	end.port.NotifyAvailable(now)
	end.busy = false
	return true
}

// checkDeadlock fires only when the head flit has already arrived but
// has been undeliverable to dst for the threshold cycles. A buf full of
// not-yet-arrived flits is not a deadlock — it is normal wire latency.
func (c *MultiFlitSwitchConnection) checkDeadlock(
	end *MultiFlitSwitchConnectionEnd,
	now akita.VTimeInSec,
) {
	if len(end.buf) == 0 {
		return
	}
	cycle := c.Freq.Cycle(now)
	head := end.buf[0]
	if head.arrivalCycle > cycle {
		return
	}
	if cycle-end.lastProgressCycle < deadlockWatchdogThreshold {
		return
	}
	dst := c.dstPortFor(end)
	fmt.Fprintf(os.Stderr,
		"[noc] deadlock-watchdog drop: connection=%s src-port=%s "+
			"dst-port=%s stuck=%d cycles buf=%d "+
			"head{id=%s src=%s dst=%s type=%T arrival=%d}\n",
		c.Name(), end.port.Name(), dst.Name(),
		cycle-end.lastProgressCycle,
		len(end.buf),
		head.msg.Meta().ID, head.msg.Meta().Src.Name(),
		head.msg.Meta().Dst.Name(), head.msg, head.arrivalCycle)
	// end.buf = end.buf[1:]
	end.lastProgressCycle = cycle
	if end.busy {
		end.port.NotifyAvailable(now)
		end.busy = false
	}
}

func (c *MultiFlitSwitchConnection) msgMustBeValid(msg akita.Msg) {
	if msg.Meta().Src == nil {
		panic("src is not given")
	}
	if msg.Meta().Dst == nil {
		panic("dst is not given")
	}
}

// NewMultiFlitSwitchConnection creates a new MultiFlitSwitchConnection.
// pipelineStages is the link latency in cycles; a flit is delivered
// exactly that many cycles after its SendTime. pipelineWidth is the
// maximum number of flits admitted and delivered per cycle per direction.
func NewMultiFlitSwitchConnection(
	name string,
	engine akita.Engine,
	freq akita.Freq,
	pipelineWidth int,
	pipelineStages int,
	row, col int,
) *MultiFlitSwitchConnection {
	c := new(MultiFlitSwitchConnection)
	c.TickingComponent = akita.NewSecondaryTickingComponent(
		name, engine, freq, c)
	c.Engine = engine
	c.Freq = freq
	c.row = row
	c.col = col
	c.pipelineWidth = pipelineWidth
	c.pipelineStages = pipelineStages
	return c
}
