#!/bin/bash
go build

N=4096
STEPS=1

./jacobi2d \
    -n=$N \
    -steps=$STEPS \
    -timing \
    -report-all \
    -verify \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Ydiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="jacobi2d_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="jacobi2d_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
