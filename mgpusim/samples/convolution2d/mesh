#!/bin/bash
go build

NAME=convolution2d

X_DIM=6
Y_DIM=6

PLATFORM="mesh"

NI=8192
NJ=8192

./$NAME \
    -ni=$NI \
    -nj=$NJ \
    -verbose \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -xDim=$X_DIM \
    -yDim=$Y_DIM \
    -metric-file-name="${NAME}_${X_DIM}x${Y_DIM}_${PLATFORM}"
