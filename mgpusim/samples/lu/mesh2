#!/bin/bash
go build

N=256
K=1

./lu \
    -n=$N \
    -k=$K \
    -timing \
    -report-all \
    -verify \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="lu_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="lu_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
