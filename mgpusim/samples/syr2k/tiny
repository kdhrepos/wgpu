#!/bin/bash
go build

NI=1024
NJ=1024
MAX_INST=1000000000

./syr2k \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="syr2k_4x4_tiny_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="syr2k_4x4_tiny_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
