#!/bin/bash
go build

NI=8192
NJ=8192

MAX_INST=100000000

./syr2k \
    -ni=$NI \
    -nj=$NJ \
    -timing \
    -verbose \
    -fast-h2d \
    -checkpoint=25 \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=pt-ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -data-partitioning="row-based,row-based,row-based" \
    -xDim=6 \
    -yDim=6 \
    -metric-file-name=syr2k_ptideal_6x6
