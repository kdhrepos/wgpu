#!/bin/bash
go build

NI=8192
NJ=8192
MAX_INST=50000000

./syr2k \
    -ni=$NI \
    -nj=$NJ \
    -timing \
    -fast-h2d \
    -verbose \
    -report-all \
    -max-inst=$MAX_INST \
    -checkpoint=25 \
    -no-progress-bar \
    -platform-type=nearfetch \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Ydiv \
    -data-partitioning="row-based,row-based,row-based" \
    -data-strides="0,0,0" \
    -metric-file-name="syr2k_nearfetch_6x6" \
    -xDim=6 \
    -yDim=6
