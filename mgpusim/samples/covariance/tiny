#!/bin/bash
go build

NAME=covariance

NUM_M=4500
NUM_N=4500

MAX_INST=100000000

./$NAME \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -verbose \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="${NAME}_4x4_tiny_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="${NAME}_4x4_tiny_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
