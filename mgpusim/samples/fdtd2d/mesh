#!/bin/bash
go build

NAME=fdtd2d

NX=3750
NY=3750

# NX=4096 # original parameter
# NY=2048 # original parameter

MAX_INST=100000000

./$NAME \
    -nx=$NX \
    -ny=$NY \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Ydiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="${NAME}_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="${NAME}_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
