#!/bin/bash
go build

NAME=lenet

MAX_INST=1000000000

./$NAME \
    -timing \
    -report-all \
    -verbose \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=6 \
    -yDim=6 \
    -log-dir="./${NAME}_log" \
    -metric-file-name="${NAME}_mesh_6x6" \
