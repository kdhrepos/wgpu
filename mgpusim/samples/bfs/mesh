#!/bin/bash
go build

NAME=bfs

NUM_NODE=1048576
DEGREE=100
DEPTH=3

MAX_INST=15000000

./$NAME \
    -node=$NUM_NODE \
    -degree=$DEGREE \
    -depth=$DEPTH \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name="${MAX_INST}_4x4_mesh" \
    -xDim=4 \
    -yDim=4
