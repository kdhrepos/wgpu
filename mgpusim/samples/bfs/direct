#!/bin/bash
go build

NAME=bfs

NUM_NODE=1048576
DEGREE=100
DEPTH=3

MAX_INST=15000000

./$NAME \
    -node=$NUM_NODE \
    -degree=$DEGREE \
    -depth=$DEPTH \
    -timing \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -metric-file-name="${MAX_INST}_4x4_mesh" \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="${NAME}_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="${NAME}_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
