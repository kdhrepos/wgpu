#!/bin/bash
go build

NAME=lavamd

BOXES1D=24

MAX_INST=100000000

./$NAME \
    -boxes1d=$BOXES1D \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -verbose \
    -fast-h2d \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name=lavamd_mesh_6x6 \
    -xDim=6 \
    -yDim=6 \
    "$@"
