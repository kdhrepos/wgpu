#!/bin/bash
go build

MAX_INST=10716969

X_DIM=${1:-6}
Y_DIM=$X_DIM

NUM_NODES=${2:-7000000}
NUM_ITEMS=$NUM_NODES

# Probabilistic L2 hotness promotion on read hit (0 disables = original behavior).
# Override with: PROMOTE=50 ./oracle_dynamic_clustering ...
PROMOTE=${PROMOTE:-25}

./mis \
    -benchmark=mis \
    -numNodes=$NUM_NODES \
    -numItems=$NUM_ITEMS \
    -timing \
    -verbose \
    -fast-h2d \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=dynamic-clustering \
    -use-oracle-pc-table \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -data-partitioning=kernel-wide \
    -xDim=$X_DIM \
    -yDim=$Y_DIM \
    -hotness-promote-percent=$PROMOTE \
    -metric-file-name=mis_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM"_promote"$PROMOTE \
    -trace-dist-filename=mis_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM"_promote"$PROMOTE"_"dist_trace
