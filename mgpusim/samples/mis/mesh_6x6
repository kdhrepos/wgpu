#!/bin/bash
go build

NUM_NODES=524288
NUM_ITEMS=1048576

./mis \
    -numNodes=$NUM_NODES \
    -numItems=$NUM_ITEMS \
    -timing \
    -verbose \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="mis_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="mis_4x4_evicted_cachelines" \
    -xDim=6 \
    -yDim=6
