#!/bin/bash
go build

NAME=gups

MAX_INST=30000000

./$NAME \
    -thread-block-size=128 \
    -nthread-blocks=16384 \
    -table-param=16 \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=direct \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=6 \
    -yDim=6 \
    -metric-file-name="${NAME}_direct_6x6_256" \
