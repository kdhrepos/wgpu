#!/bin/bash
go build

NAME=spmv

DIM=2097152
SPARSITY=0.00001

X_DIM=${1:-6}
Y_DIM=$X_DIM

./$NAME \
    -dim=$DIM \
    -sparsity=$SPARSITY \
    -timing \
    -report-all \
    -max-inst=23182452 \
    -no-progress-bar \
    -platform-type=dynamic-clustering \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -data-partitioning="kernel-wide" \
    -metric-file-name="spmv_dynamic-clustering_${X_DIM}x${Y_DIM}" \
    -xDim=$X_DIM \
    -yDim=$Y_DIM