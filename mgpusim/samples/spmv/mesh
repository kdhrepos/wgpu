#!/bin/bash
go build

NAME=spmv

DIM=2097152
SPARSITY=0.00001

MAX_INST=23182452

./$NAME \
    -dim=$DIM \
    -sparsity=$SPARSITY \
    -max-inst=$MAX_INST \
    -fast-h2d \
    -verbose \
    -ooo-debug \
    -report-all \
    -checkpoint=25 \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name="spmv_mesh_6x6" \
    -xDim=6 \
    -yDim=6
