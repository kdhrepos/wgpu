#!/bin/bash
go build

MAX_INST=5795613

X_DIM=${1:-6} 
Y_DIM=$X_DIM

DIM=${2:-2097152}
SPARSITY=0.00001

./spmv \
    -benchmark=spmv \
    -dim=$DIM \
    -sparsity=$SPARSITY \
    -fast-h2d \
    -timing \
    -verbose \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=dynamic-clustering \
    -use-oracle-pc-table \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=$X_DIM \
    -yDim=$Y_DIM \
    -metric-file-name=spmv_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM \
    -trace-dist-filename=spmv_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM"_"dist_trace

