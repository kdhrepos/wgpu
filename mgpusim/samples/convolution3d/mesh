#!/bin/bash
go build

NAME=convolution3d

NI=350
NJ=350
NK=350

MAX_INST=100000000

./$NAME \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name="${MAX_INST}_4x4_mesh" \
    -xDim=4 \
    -yDim=4
