#!/bin/bash
# Stress test for R1 (endpoint flitsToAssemble HOL deadlock).
#
# Narrow 2x2 mesh forces all-to-all traffic to converge on a few chiplets,
# multiplying the chance that one endpoint's flitAssemblingBufferSize (=64
# by default) fills with partial-msg flits from several concurrent sources
# while their missing flits are stuck upstream — the canonical R1 scenario.
#
# Watch for: simulation hang, RDMA PushToRetryPort spam, or
# average-latency-hop-traced-* spikes in the resulting metrics file.

go build

NAME=gemm

NI=3500
NJ=3500
NK=3500

./$NAME \
    -i=$NI \
    -j=$NJ \
    -k=$NK \
    -timing \
    -report-all \
    -verbose \
    -no-progress-bar \
    -fast-h2d \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=2 \
    -yDim=2 \
    -metric-file-name=gemm_mesh_2x2
