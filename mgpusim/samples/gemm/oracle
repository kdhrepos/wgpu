#!/bin/bash
# llama3_70B_gemm on oracle dynamic-clustering (4x4).
# Mirrors scripts/params.py entry 'llama3_70B_gemm'.

go build

NAME=gemm
ALIAS=llama3_70B_gemm

XDIM=6
YDIM=6

NI=2048
NJ=28672
NK=8192

MAX_INST=75000000

# Probabilistic L2 hotness promotion on read hit (0 disables = original behavior).
# Override with: PROMOTE=50 ./oracle_dynamic_clustering
PROMOTE=${PROMOTE:-0}

./$NAME \
    -benchmark=$ALIAS \
    -i=$NI -j=$NJ -k=$NK \
    -verbose \
    -fast-h2d \
    -timing \
    -report-all \
    -no-progress-bar \
    -platform-type=dynamic-clustering \
    -use-oracle-pc-table \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition="Xdiv" \
    -data-partitioning="row-based,col-based,col-based" \
    -data-strides="0,114688,114688" \
    -max-inst=$MAX_INST \
    -xDim=$XDIM \
    -yDim=$YDIM \
    -hotness-promote-percent=$PROMOTE \
    -metric-file-name="${ALIAS}_oracle_dynamic-clustering_${XDIM}x${YDIM}"
