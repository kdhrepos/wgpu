#!/bin/bash
# Diagnostic: identical to ./mesh but with a tiny problem size.
# Purpose: isolate whether the "address is smaller than offset" panic is a
# problem-size / 64-bit-address issue (emu truncation) or a structural bug.
#
#   passes clean  -> address-magnitude/arithmetic problem (emu), scale was the trigger
#   same 0xfc0 panic -> structural (independent of size)
#
# Only ISOTOPES stays 68 (materials hardcode nuclide IDs up to ~67/320, so
# fewer isotopes would itself read out of bounds). Everything else shrunk;
# all platform/scheduling/LASP flags kept identical to ./mesh.
go build

ISOTOPES=68
GRIDPOINTS=64
LOOKUPS=1024
GRID_TYPE=unionized

./xsbench \
    -isotopes=$ISOTOPES \
    -gridpoints=$GRIDPOINTS \
    -lookups=$LOOKUPS \
    -grid-type=$GRID_TYPE \
    -timing \
    -report-all \
    -fast-h2d \
    -verbose \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -data-partitioning=kernel-wide \
    -metric-file-name=xsbench_mesh_6x6_small \
    -trace-memory-access \
    -trace-memory-access-filename=xsbench_mesh_6x6_small_memory_trace \
    -xDim=6 \
    -yDim=6 \
    "$@"
