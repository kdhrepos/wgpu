#!/bin/bash
go build

NAME=sssp

NUM_NODES=6291456
NUM_ITEMS=12582912

MAX_INST=15000000

./$NAME \
    -num-nodes=$NUM_NODES \
    -num-items=$NUM_ITEMS \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name="${MAX_INST}_4x4_mesh" \
    -xDim=4 \
    -yDim=4
