#!/bin/bash
go build

MAX_INST=30000000

X_DIM=${1:-6} 
Y_DIM=$X_DIM

NODE=${2:-2048}
SPARSITY=0.5
ITER=1

# Probabilistic L2 hotness promotion on read hit (0 disables = original behavior).
# Override with: PROMOTE=50 ./oracle_dynamic_clustering ...
PROMOTE=${3:-0}

./pagerank \
    -benchmark=pagerank_test \
    -node=$NODE \
    -sparsity=$SPARSITY \
    -iterations=$ITER \
    -timing \
    -fast-h2d \
    -verbose \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=dynamic-clustering \
    -use-oracle-pc-table \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=$X_DIM \
    -yDim=$Y_DIM \
    -metric-file-name=pagerank_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM \
    -trace-dist-filename=pagerank_oracle_dynamic_clustering_$X_DIM"x"$Y_DIM"_"dist_trace
