#!/bin/bash
go build

NODE=8192
SPARSITY=0.5
ITER=1

./pagerank \
    -node=$NODE \
    -sparsity=$SPARSITY \
    -iterations=$ITER \
    -timing \
    -report-all \
    -verify \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -metric-file-name="large_mesh_4x4" \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="pr_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="pr_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
