#!/bin/bash
go build

NODE=8192
SPARSITY=0.5
ITER=1

./pagerank \
    -node=$NODE \
    -sparsity=$SPARSITY \
    -iterations=$ITER \
    -timing \
    -report-all \
    -verify \
    -no-progress-bar \
    -platform-type=ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -metric-file-name="4x4_large_ideal" \
    -xDim=4 \
    -yDim=4
