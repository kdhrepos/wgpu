#!/bin/bash
# platform-type=mesh, benchmark params mirror score (scripts/params.py['matrixmultiplication']).
go build

NAME=matrixmultiplication

# grid (square wafer-scale mesh)
XDIM=6
YDIM=6

# matrixmultiplication params (params.py)
X=12288
Y=12288
Z=12288
SCHED_PARTITION="Ydiv"
DATA_PARTITIONING="row-based,col-based,stride-aware"
DATA_STRIDES="0,49152,0"
MAX_INST=1000000000

./$NAME \
    -x=$X \
    -y=$Y \
    -z=$Z \
    -fast-h2d \
    -verbose \
    -timing \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=$SCHED_PARTITION \
    -data-partitioning=$DATA_PARTITIONING \
    -data-strides=$DATA_STRIDES \
    -col-size-for-lasp=0 \
    -max-inst=$MAX_INST \
    -xDim=$XDIM \
    -yDim=$YDIM
