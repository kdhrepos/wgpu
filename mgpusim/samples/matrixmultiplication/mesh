#!/bin/bash
# platform-type=mesh
go build

NAME=matrixmultiplication

# grid (square wafer-scale mesh)
XDIM=6
YDIM=6

# matrixmultiplication params
X=12288
Y=12288
Z=12288
MAX_INST=1000000000

./$NAME \
    -x=$X \
    -y=$Y \
    -z=$Z \
    -fast-h2d \
    -verbose \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -max-inst=$MAX_INST \
    -xDim=$XDIM \
    -yDim=$YDIM
