#!/bin/bash
go build

WIDTH=1024
HEIGHT=1024

./raytracing \
    -width=$WIDTH \
    -height=$HEIGHT \
    -timing \
    -report-all \
    -fast-h2d \
    -verbose \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name=raytracing_mesh_6x6 \
    -trace-memory-access \
    -trace-memory-access-filename=raytracing_mesh_6x6_memory_trace \
    -xDim=6 \
    -yDim=6 \
    "$@"
