#!/bin/bash
go build

NAME=kmeans

POINTS=524288
FEATURES=32
CLUSTERS=20
MAX_ITER=1

./$NAME \
    -points=$POINTS \
    -features=$FEATURES \
    -clusters=$CLUSTERS \
    -max-iter=$MAX_ITER \
    -report-all \
    -no-progress-bar \
    -verbose \
    -platform-type=mesh \
    -xDim=2 \
    -yDim=2
