#!/bin/bash
go build

NAME=mm2

NI=3000
NJ=3000
NK=3000
NL=3000

MAX_INST=15000000

./$NAME \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -nl=$NL \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -metric-file-name="${MAX_INST}_4x4_ideal" \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="${NAME}_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="${NAME}_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
