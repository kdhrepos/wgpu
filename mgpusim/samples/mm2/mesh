#!/bin/bash
go build

NI=3000
NJ=3000
NK=3000
NL=3000

MAX_INST=15000000

./mm2 \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -nl=$NL \
    -timing \
    -report-all \
    -no-progress-bar \
    -max-inst=$MAX_INST \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Ydiv \
    -xDim=6 \
    -yDim=6
