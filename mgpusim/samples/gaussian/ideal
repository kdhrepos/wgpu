#!/bin/bash
go build

SIZE=1024

MAX_INST=30000000

./gaussian \
    -size=$SIZE \
    -timing \
    -verbose \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -metric-file-name="gaussian_ideal_4x4_${MAX_INST}" \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -xDim=4 \
    -yDim=4
