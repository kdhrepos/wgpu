#!/bin/bash
go build

NAME=lud

MatrixDim=12288

MAX_INST=200000000

./$NAME \
    -matrix-dim=$MatrixDim \
    -timing \
    -report-all \
    -fast-h2d \
    -verbose \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv,Xdiv,Ydiv \
    -xDim=6 \
    -yDim=6 \
    -metric-file-name=lud_ideal_6x6 \
    -core-file-name=lud_ideal_6x6_core \
    "$@"
