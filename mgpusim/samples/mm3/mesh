#!/bin/bash
go build

NI=2900
NJ=2900
NK=2900
NL=2900
NM=2900

MAX_INST=15000000

./mm3 \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -nl=$NL \
    -nm=$NM \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -metric-file-name="${MAX_INST}_4x4_mesh" \
    -xDim=4 \
    -yDim=4
