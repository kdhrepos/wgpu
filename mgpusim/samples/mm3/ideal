#!/bin/bash
go build

NI=2900
NJ=2900
NK=2900
NL=2900
NM=2900

MAX_INST=15000000

./mm3 \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -nl=$NL \
    -nm=$NM \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=ideal \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -metric-file-name="${MAX_INST}_4x4_ideal" \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="mm3_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="mm3_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
