#!/bin/bash
go build

NI=64
NJ=64
NK=64
NL=64
NM=64

./mm3 \
    -ni=$NI \
    -nj=$NJ \
    -nk=$NK \
    -nl=$NL \
    -nm=$NM \
    -timing \
    -report-all \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="mm3_4x4_tiny_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="mm3_4x4_tiny_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
