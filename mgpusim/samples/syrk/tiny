#!/bin/bash
go build

NI=2048
NJ=2048
MAX_INST=1000000000

./syrk \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="syrk_4x4_tiny_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="syrk_4x4_tiny_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
