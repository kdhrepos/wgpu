#!/bin/bash
go build

NI=2048
NJ=2048
MAX_INST=15000000

./syrk \
    -ni=$NI \
    -nj=$NJ \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -mem-allocator-type=lasp \
    -use-lasp-mem-alloc \
    -scheduling=lasp \
    -sched-partition=Xdiv \
    -metric-file-name="${MAX_INST}_4x4" \
    -trace-access-count-per-addrs=true \
    -trace-access-count-per-addrs-filename="syrk_4x4_access_count" \
    -trace-evicted-cacheline=true \
    -trace-evicted-cacheline-filename="syrk_4x4_evicted_cachelines" \
    -xDim=4 \
    -yDim=4
