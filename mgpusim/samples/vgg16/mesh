#!/bin/bash
go build

NAME=vgg16

MAX_INST=100000000

./$NAME \
    -timing \
    -report-all \
    -max-inst=$MAX_INST \
    -no-progress-bar \
    -platform-type=mesh \
    -xDim=6 \
    -yDim=6 \
    -metric-file-name="${NAME}_mesh_6x6" \
    -trace-memory-access=true \
    -trace-memory-access-filename="${NAME}_mesh_6x6_memory_trace"
